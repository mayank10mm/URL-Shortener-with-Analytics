# Neon (pooled connection string). Server only — never expose to the browser.
DATABASE_URL=

# Upstash Redis REST. Server only. Shared DB: all keys use urlshortener: prefix.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk. Publishable key is browser-safe. Secret key is server only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# App URL (used in later phases)
NEXT_PUBLIC_APP_URL=http://localhost:3000
